# Public base URL of the deployed site, used to resolve absolute metadata
# (Open Graph / Twitter image URLs, canonical links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://src-zeta-teal.vercel.app

# Payload CMS secret — a long random string, unique per environment.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=

# Postgres connection string. Local dev uses a local Postgres; production uses
# the Neon pooled connection string (from the Vercel Marketplace integration).
POSTGRES_URL=postgres://src:src@127.0.0.1:5433/src

# Vercel Blob token for media/document uploads. When empty, uploads fall back to
# local disk (fine for development). Set per environment in Vercel.
BLOB_READ_WRITE_TOKEN=

# ─── Forms (Phase 6) — all optional; features degrade gracefully when unset ───

# Salt for hashing IPs and newsletter tokens. Set a random value in production.
FORM_SALT=

# Resend transactional email. Without a key, emails are logged, not sent.
RESEND_API_KEY=
RESEND_FROM="SRC <noreply@your-verified-domain.org>"
CONTACT_INBOX=hello@src-sudan.org

# Cloudflare Turnstile. Without keys, verification is skipped (dev/CI).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis for rate limiting. Without it, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
